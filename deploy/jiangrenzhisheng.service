[Unit]
Description=JiangRenZhiSheng photo service
After=network.target

[Service]
Type=simple
User=jiangren
Group=jiangren
WorkingDirectory=/opt/jiangrenzhisheng-server
ExecStart=/usr/bin/node --env-file=/opt/jiangrenzhisheng-server/.env src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=160
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/jiangrenzhisheng-server/data
UMask=0077

[Install]
WantedBy=multi-user.target
