HOST=127.0.0.1
PORT=3000
# 替换为实际域名，手机必须能访问；Nginx 默认 HTTPS 8443，不要填 localhost。
PUBLIC_BASE_URL=https://photos.example.com:8443
# JSON 对象：设备标识 -> 不少于 32 字符的随机密钥。请替换，不要提交真实密钥。
DEVICE_KEYS={"experience-01":"replace-with-a-random-secret-at-least-32-chars"}
DATA_DIR=./data
RETENTION_HOURS=72
MAX_UPLOAD_MB=30
MAX_STORAGE_MB=10240
UPLOADS_PER_MINUTE=10
MAX_CONCURRENT_UPLOADS=2
CLEANUP_INTERVAL_MINUTES=10
# 仅有一层本机 Nginx 代理时使用 loopback；直接部署保持 false。
TRUST_PROXY=false
